# TestPilot - Docker Compose Environment
# =====================================
# Bu dosyayi repo kokunde .env olarak kopyalayabilirsin:
#   cp .env.example .env

# Demo/release icin "gemini" kullanin. "mock" yalnizca lokal deterministik gelistirme icindir.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000
LLM_FALLBACK_TO_MOCK=false
DEMO_RESET_ON_STARTUP=true
