# TestPilot - Docker Compose Environment
# =====================================
# Bu dosyayi repo kokunde .env olarak kopyalayabilirsin:
#   cp .env.example .env

# "mock" API key gerektirmez. "gemini" icin GEMINI_API_KEY doldurulmalidir.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_FALLBACK_TO_MOCK=true
