# TestPilot – Environment Variables
# ===================================
# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   cp .env.example .env
# Not: Docker Compose ile çalıştırırken repo kökündeki .env.example dosyasını kullan.

# ── Genel ───────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────
DATABASE_PATH=data/testpilot.db

# Demo erişim anahtarları her backend başlangıcında temiz başlasın.
# false yapılırsa local history/usage restart sonrası korunur.
DEMO_RESET_ON_STARTUP=true

# Free export provenance imzaları için kullanılır.
# Production/demo ortamında güçlü ve gizli bir değer ver.
EXPORT_SIGNATURE_SECRET=change-this-export-signature-secret

# ── LLM Provider ─────────────────────────────────────────
# "mock" → deterministik mock generator (API key gerektirmez)
# "gemini" → gerçek Google Gemini API (GEMINI_API_KEY gerekli)
LLM_PROVIDER=gemini

# ── Gemini API ───────────────────────────────────────────
# https://aistudio.google.com/app/apikey adresinden ücretsiz alabilirsin
GEMINI_API_KEY=

# Kullanılacak model (önerilen: gemini-2.0-flash — hızlı ve ücretsiz)
# Alternatifler: gemini-1.5-pro, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Gemini HTTP timeout (milisaniye)
GEMINI_TIMEOUT_MS=30000

# Gemini başarısız olursa mock'a düş (true/false)
# false = Gemini hata verirse 503 döner; demo sırasında gerçek/mock belirsizliği oluşmaz
# true = Gemini hatasında üretim akışı mock ile devam eder
LLM_FALLBACK_TO_MOCK=false
